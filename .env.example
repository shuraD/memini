# Environment variables Memini reads. NAMES ONLY: never put a value in this file.
# Copy to .env (gitignored) and fill it in, then load it into your shell before starting
# a tool:  set -a && source .env && set +a
# Memini's code reads os.environ only; nothing in Memini opens .env itself.

# Local test Neo4j (local only: the is_local_uri guard refuses any other host)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
# Optional: database name; empty = the user's home database
NEO4J_DATABASE=

# Production Neo4j host, used only by tests that prove it is refused. Never connect to it.
MEMINI_PROD_NEO4J_HOST=

# Corpus for the acceptance tier (read-only)
MEMINI_CORPUS=
# Opt-in acceptance tier: 1 = run tests/acceptance
MEMINI_ACCEPTANCE=

# Optional: a config directory that replaces the packaged config/
MEMINI_CONFIG_DIR=

MEMINI_PRIVATE_VOCAB=

# LLM provider keys (config/providers.yaml, key_env)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
